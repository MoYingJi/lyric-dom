{
  "name": "lyric-dom",
  "version": "0.1.0",
  "description": "框架无关的高性能歌词渲染引擎（Apple Music 风格逐字歌词）",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./renderer.css": "./dist/renderer.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsup",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "keywords": [
    "lyrics",
    "karaoke",
    "apple-music",
    "dom",
    "renderer"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "happy-dom": "^20.13.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
