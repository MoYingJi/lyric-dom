{
  "name": "lyric-dom",
  "version": "0.1.0",
  "description": "A framework-agnostic karaoke lyrics renderer for the browser, built on the native DOM API with zero runtime dependencies.",
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./renderer.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsdown",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "keywords": [
    "lyrics",
    "karaoke",
    "dom",
    "renderer"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@tsdown/css": "^0.22.14",
    "happy-dom": "^20.13.2",
    "lyric-kit": "^0.2.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "license": "AGPL-3.0"
}
